# ================================================================
# Alpaca Paper Trading Account Configuration
# ================================================================
# Endpoint: https://paper-api.alpaca.markets/v2
ALPACA_API_KEY=PK_YOUR_PAPER_KEY_HERE
ALPACA_SECRET_KEY=YOUR_PAPER_SECRET_HERE
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
IS_PAPER=True

# ================================================================
# Trading Risk Controls
# ================================================================
MAX_CONCURRENT_POSITIONS=5
RISK_PER_TRADE_PERCENT=2.0
STOP_LOSS_ATR_MULTIPLE=1.5
TAKE_PROFIT_ATR_MULTIPLE=3.0

# ================================================================
# Laya & Sentiment Thresholds
# ================================================================
MIN_BUY_SENTIMENT_POS=0.65
MAX_SELL_SENTIMENT_NEG=0.65

# ================================================================
# Sentiment backend: TypeSafe Jev first, Laya fallback
# ================================================================
# jev  = call TypeSafe Jev; switch to in-process Laya on quota/auth errors
#        or repeated failures. laya = Laya only.
SENTIMENT_BACKEND=jev
TYPESAFE_API_KEY=apikey_YOUR_TYPESAFE_KEY_HERE
TYPESAFE_MODEL=jev-latest

# ================================================================
# RL policy (rl/, python -m rl.train)
# ================================================================
# auto   = trade only a policy that passed its promotion gate, else shadow
# shadow = decide and log, never trade
# live   = trade whatever policy is deployed (paper only!)
# off    = not consulted
RL_MODE=auto
